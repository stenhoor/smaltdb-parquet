{
  "name": "@smaltdb/parquet",
  "version": "0.9.0",
  "description": "Parquet format for smaltdb external tables and read_parquet()",
  "keywords": [
    "smaltdb",
    "parquet",
    "sql"
  ],
  "author": "stenhoor",
  "license": "MIT",
  "homepage": "https://github.com/stenhoor/smaltdb-parquet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stenhoor/smaltdb-parquet.git"
  },
  "bugs": {
    "url": "https://github.com/stenhoor/smaltdb-parquet/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "deps": "node scripts/fetch-packed.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/fetch-packed.mjs --check && node node_modules/typescript7/bin/tsc -p tsconfig.json",
    "test": "node scripts/fetch-packed.mjs --check && vitest run",
    "test:browser": "node scripts/fetch-packed.mjs --check && node test/browser/run.mjs",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "hyparquet": "1.31.4",
    "hyparquet-compressors": "1.1.2"
  },
  "peerDependencies": {
    "smaltdb": ">=0.9.0 <0.10.0"
  },
  "peerDependenciesMeta": {
    "smaltdb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "typescript7": "npm:typescript@~7.0.2",
    "vitest": "^5.0.5"
  }
}
